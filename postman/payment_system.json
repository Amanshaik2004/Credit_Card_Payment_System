              "mode": "raw",
              "raw": "{\n  \"card_id\": {{card_id}},\n  \"amount\": 89.50,\n  \"currency\": \"USD\",\n  \"cvv\": \"000\",\n  \"description\": \"Simulated failed transaction\"\n}"
            },
            "url": {
              "raw": "{{fastapi_base_url}}/api/payments/pay",
              "host": ["{{fastapi_base_url}}"],
              "path": ["api", "payments", "pay"]
            }
          }
        },
        {
          "name": "Check Payment Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
