    {
      "name": "2. Card Management (Django)",
      "item": [
        {
          "name": "Add Visa Credit Card",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.card && jsonData.card.id) {",
                  "    pm.collectionVariables.set('card_id', jsonData.card.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"card_holder_name\": \"John Doe\",\n  \"card_type\": \"CREDIT\",\n  \"card_number\": \"4532015112830366\",\n  \"cvv\": \"123\",\n  \"expiry_month\": 12,\n  \"expiry_year\": 2029\n}"
            },
            "url": {
              "raw": "{{django_base_url}}/api/cards/",
              "host": ["{{django_base_url}}"],
              "path": ["api", "cards", ""]
            }
          }
        },
        {
          "name": "View Saved Cards",
          "request": {
            "method": "GET",
