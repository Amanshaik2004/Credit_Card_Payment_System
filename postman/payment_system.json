            "body": {
              "mode": "raw",
              "raw": "{\n  \"card_id\": {{card_id}},\n  \"amount\": 199.99,\n  \"currency\": \"USD\",\n  \"cvv\": \"123\",\n  \"description\": \"Electronics purchase online\"\n}"
            },
            "url": {
